}
db_ipapi(){
local temp_info="$Font_Cyan$Font_B${sinfo[database]}${Font_I}ipapi $Font_Suffix"
((ibar_step+=3))
show_progress_bar "$temp_info" $((40-6-${sinfo[ldatabase]}))
ipapi=()
ipapi[status]="unknown"
typeset api_key="${provider_credentials[IPAPI_API_KEY]:-}"
ipapi[credential_mode]=anonymous
[[ -n "$api_key" ]]&&ipapi[credential_mode]=key
typeset endpoint="https://api.ipapi.is/?q=$IP"
[[ -n "$api_key" ]]&&endpoint="$endpoint&key=$api_key"
typeset wire_response curl_exit http_code RESPONSE
if [[ -n "$api_key" ]];then
wire_response=$(curl_with_secret_url "$endpoint" $CurlARG -sS -L -$1 -m 10 \
  --max-filesize 262144 --write-out $'\n%{http_code}' 2>/dev/null)
else
wire_response=$(curl_safe $CurlARG -sS -L -$1 -m 10 -H 'origin: https://ipapi.is' \
  --max-filesize 262144 --write-out $'\n%{http_code}' "$endpoint" 2>/dev/null)
fi
curl_exit=$?
if (( curl_exit != 0 )) || [[ "$wire_response" != *$'\n'* ]];then
ipapi[status]="network_error"
case "$curl_exit" in
28)ipapi[status]=timeout ;;
35)ipapi[status]=tls_error ;;
60)ipapi[status]=tls_verification_failed ;;
esac
return 1
fi
http_code="${wire_response##*$'\n'}"
RESPONSE="${wire_response%$'\n'*}"
if [[ "$http_code" != [0-9][0-9][0-9] ]] || (( 10#$http_code < 200 || 10#$http_code > 299 ));then
ipapi[status]=$(provider_http_failure_status "$http_code" "$RESPONSE")
return 1
fi
if ! ipapi_parse_response "$RESPONSE" "$IP";then
ipapi[status]="invalid_response"
return 1
fi
ipapi[status]="ok"
ipapi[source]="public_api"
ipapi[mode]="${ipapi_parsed[mode]}"
ipapi[ip]="${ipapi_parsed[ip]}"
ipapi[anonymous_asn]="${ipapi_parsed[anonymous_asn]}"
ipapi[anonymous_company]="${ipapi_parsed[anonymous_company]}"
ipapi[anonymous_country]="${ipapi_parsed[anonymous_country]}"
ipapi[anonymous_city]="${ipapi_parsed[anonymous_city]}"
ipapi[anonymous_region]="${ipapi_parsed[anonymous_region]}"
ipapi[anonymous_timezone]="${ipapi_parsed[anonymous_timezone]}"
ipapi[usetype]="${ipapi_parsed[usage_type]}"
ipapi[comtype]="${ipapi_parsed[company_type]}"
case ${ipapi[usetype]} in
"business")ipapi[susetype]="${stype[business]}"
;;
"isp")ipapi[susetype]="${stype[isp]}"
;;
"hosting")ipapi[susetype]="${stype[hosting]}"
;;
"education")ipapi[susetype]="${stype[education]}"
;;
"government")ipapi[susetype]="${stype[government]}"
;;
"banking")ipapi[susetype]="${stype[banking]}"
;;
""|"null")ipapi[susetype]="${stype[unknown]}"
;;
*)ipapi[susetype]="${stype[other]}"
esac
case ${ipapi[comtype]} in
"business")ipapi[scomtype]="${stype[business]}"
;;
"isp")ipapi[scomtype]="${stype[isp]}"
;;
"hosting")ipapi[scomtype]="${stype[hosting]}"
;;
"education")ipapi[scomtype]="${stype[education]}"
;;
"government")ipapi[scomtype]="${stype[government]}"
;;
"banking")ipapi[scomtype]="${stype[banking]}"
;;
""|"null")ipapi[scomtype]="${stype[unknown]}"
;;
*)ipapi[scomtype]="${stype[other]}"
esac
ipapi[scoretext]="${ipapi_parsed[score_text]}"
ipapi[scorenum]=$(echo "${ipapi[scoretext]}"|awk '{print $1}')
ipapi[risktext]=$(echo "${ipapi[scoretext]}"|awk -F'[()]' '{print $2}')
if is_nonnegative_decimal "${ipapi[scorenum]}";then
ipapi[score]=$(awk "BEGIN {printf \"%.2f%%\", ${ipapi[scorenum]} * 100}")
case ${ipapi[risktext]} in
"Very Low")ipapi[risk]="${sscore[verylow]}"
;;
"Low")ipapi[risk]="${sscore[low]}"
;;
"Elevated")ipapi[risk]="${sscore[elevated]}"
;;
"High")ipapi[risk]="${sscore[high]}"
;;
"Very High")ipapi[risk]="${sscore[veryhigh]}"
esac
else
ipapi[scorenum]=""
ipapi[score]=""
ipapi[risk]=""
fi
ipapi[countrycode]="${ipapi_parsed[country_code]}"
ipapi[proxy]="${ipapi_parsed[proxy]}"
ipapi[tor]="${ipapi_parsed[tor]}"
ipapi[vpn]="${ipapi_parsed[vpn]}"
ipapi[server]="${ipapi_parsed[server]}"
ipapi[abuser]="${ipapi_parsed[abuser]}"
ipapi[robot]="${ipapi_parsed[robot]}"
ipapi[risk_status]=not_provided
provider_has_observation "${ipapi[proxy]}" "${ipapi[vpn]}" "${ipapi[tor]}" "${ipapi[server]}" "${ipapi[abuser]}" "${ipapi[robot]}"&&ipapi[risk_status]=ok
return 0
}
db_ipwhois(){
local temp_info="$Font_Cyan$Font_B${sinfo[database]}${Font_I}IPWHOIS public demo $Font_Suffix"
((ibar_step+=3))
show_progress_bar "$temp_info" $((40-9-${sinfo[ldatabase]}))
ipwhois=()
ipwhois[status]="unknown"
ipwhois[source]="public_demo"
provider_fetch_public_json "$1" "https://ipwhois.io/demo?ip=$IP" 131072 \
  -A 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36' \
  -H 'Accept: */*' -H 'Origin: https://ipwhois.io' -H 'Referer: https://ipwhois.io/' \
  -H 'Sec-Fetch-Dest: empty' -H 'Sec-Fetch-Mode: cors' -H 'Sec-Fetch-Site: same-origin'||true
ipwhois[status]="$PROVIDER_RESPONSE_STATUS"
local RESPONSE="$PROVIDER_RESPONSE_BODY"
[[ "${ipwhois[status]}" == "ok" ]]||return 0
if ipwhois_parse_response "$RESPONSE" "$IP";then
ipwhois[status]="ok"
ipwhois[risk_status]="${ipwhois_parsed[risk_status]}"
ipwhois[countrycode]="${ipwhois_parsed[country_code]}"
ipwhois[asn]="${ipwhois_parsed[asn]}"
ipwhois[org]="${ipwhois_parsed[organization]}"
ipwhois[isp]="${ipwhois_parsed[isp]}"
ipwhois[timezone]="${ipwhois_parsed[timezone]}"
ipwhois[proxy]="${ipwhois_parsed[proxy]}"
ipwhois[vpn]="${ipwhois_parsed[vpn]}"
ipwhois[tor]="${ipwhois_parsed[tor]}"
ipwhois[server]="${ipwhois_parsed[hosting]}"
else
ipwhois[status]="${ipwhois_parsed[status]:-invalid_response}"
fi
}
db_dbip(){
local temp_info="$Font_Cyan$Font_B${sinfo[database]}${Font_I}DB-IP public demo $Font_Suffix"
((ibar_step+=3))
show_progress_bar "$temp_info" $((40-9-${sinfo[ldatabase]}))
dbip=()
dbip[source]="public_demo"
dbip[status]=unknown
typeset wire_response response_body http_code guest_key endpoint
typeset -a demo_headers
demo_headers=(-A 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36' \
  -H 'Accept: */*' -H 'Origin: https://db-ip.com' -H 'Referer: https://db-ip.com/')
# The website's current visitor demo is bound to the requesting egress. Keep
# both requests on this route, including IPv6; never substitute another IP.
endpoint='https://db-ip.com/api/core/'
typeset step
for step in page observation;do
wire_response=$(curl_with_secret_url "$endpoint" $CurlARG -sS -$1 -m 10 \
  --max-filesize 262144 --write-out $'\n%{http_code}' "${demo_headers[@]}" 2>/dev/null)
if (( $? != 0 )) || [[ "$wire_response" != *$'\n'* ]];then
dbip[status]=network_error
return 0
fi
http_code="${wire_response##*$'\n'}"
response_body="${wire_response%$'\n'*}"
if [[ "$http_code" != 200 ]];then
dbip[status]=$(provider_http_failure_status "$http_code" "$response_body")
return 0
fi
if [[ "$step" == page ]];then
guest_key=$(dbip_demo_key_from_page "$response_body")||{
dbip[status]=invalid_response
return 0
}
endpoint="https://api.db-ip.com/v2/$guest_key/self?convertCurrencies"
fi
done
if dbip_parse_response "$response_body" "$IP";then
dbip[status]=ok
dbip[risk_status]="${dbip_parsed[risk_status]}"
dbip[threat_level]="${dbip_parsed[threat_level]}"
case "${dbip[threat_level]}" in
low)dbip[risk]="${sscore[low]}" ;;
medium)dbip[risk]="${sscore[medium]}" ;;
high)dbip[risk]="${sscore[high]}" ;;
esac
dbip[ip]="${dbip_parsed[ip]}"
dbip[countrycode]="${dbip_parsed[country_code]}"
dbip[country]="${dbip_parsed[country]}"
dbip[region]="${dbip_parsed[region]}"
dbip[city]="${dbip_parsed[city]}"
else
dbip[status]="${dbip_parsed[status]:-invalid_response}"
fi
}
db_cloudflare(){
local temp_info="$Font_Cyan$Font_B${sinfo[database]}${Font_I}Cloudflare IP Intelligence $Font_Suffix"
((ibar_step+=3))
show_progress_bar "$temp_info" $((40-12-${sinfo[ldatabase]}))
cloudflare=()
cloudflare[status]="not_configured"
typeset api_token="${provider_credentials[CLOUDFLARE_API_TOKEN]:-}"
typeset account_id="${provider_credentials[CLOUDFLARE_ACCOUNT_ID]:-}"
[[ -n "$api_token" || -n "$account_id" ]]||return 0
if [[ -z "$api_token" || -z "$account_id" ]];then
cloudflare[status]="invalid_configuration"
return 0
fi
cloudflare[status]="unknown"
local query_name="ipv4"
[[ "$IP" == *:* ]]&&query_name="ipv6"
local endpoint="https://api.cloudflare.com/client/v4/accounts/$account_id/intel/ip?$query_name=$IP"
local wire_response curl_exit http_code response_body
wire_response=$(curl_with_secret_header "Authorization" "Bearer $api_token" "$endpoint" \
  $CurlARG -sS -L -$1 -m 10 --max-filesize 131072 --write-out $'\n%{http_code}' 2>/dev/null)
curl_exit=$?
if (( curl_exit != 0 )) || [[ "$wire_response" != *$'\n'* ]];then
cloudflare[status]="network_error"
return 0
fi
http_code="${wire_response##*$'\n'}"
response_body="${wire_response%$'\n'*}"
if [[ "$http_code" != [0-9][0-9][0-9] ]] || (( 10#$http_code < 200 || 10#$http_code > 299 ));then
cloudflare[status]=$(provider_http_failure_status "$http_code" "$response_body")
return 0
fi
if ! provider_json_is_object "$response_body";then
cloudflare[status]="invalid_response"
return 0
fi
if ! cloudflare_parse_response "$response_body" "$IP";then
cloudflare[status]="invalid_response"
return 0
fi
cloudflare[status]="${cloudflare_parsed[status]}"
cloudflare[source]="official_api"
cloudflare[ip]="${cloudflare_parsed[ip]}"
cloudflare[countrycode]="${cloudflare_parsed[country_code]}"
cloudflare[network]="${cloudflare_parsed[network]}"
cloudflare[org]="${cloudflare_parsed[organization]}"
cloudflare[infrastructure]="${cloudflare_parsed[infrastructure_type]}"
cloudflare[threats]="${cloudflare_parsed[threat_categories]}"
cloudflare[threats_json]="${cloudflare_parsed[threat_categories_json]:-null}"
}

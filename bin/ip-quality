Font_Green=$'\033[32m'
Font_Yellow=$'\033[33m'
Font_Blue=$'\033[34m'
Font_Purple=$'\033[35m'
Font_Cyan=$'\033[36m'
Font_White=$'\033[37m'
Back_Black=$'\033[40m'
Back_Red=$'\033[41m'
Back_Green=$'\033[42m'
Back_Yellow=$'\033[43m'
Back_Blue=$'\033[44m'
Back_Purple=$'\033[45m'
Back_Cyan=$'\033[46m'
Back_White=$'\033[47m'
Font_Suffix=$'\033[0m'
Font_LineClear=$'\033[2K'
typeset IP=""
typeset IPhide
typeset fullIP=0
typeset YY="cn"
typeset -A maxmind

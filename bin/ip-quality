fi
}
show_dnsbl(){
echo -ne "\r${smail[sdnsbl]}\n"
if [[ -n "${smail[blacklisted_zones]}" ]];then
if [[ "$YY" == "cn" ]];then
print -r -- "${Font_Red}黑名单命中：${smail[blacklisted_zones]}${Font_Suffix}"
else
print -r -- "${Font_Red}Blacklisted by: ${smail[blacklisted_zones]}${Font_Suffix}"
fi
if [[ "${smail[blacklisted_zones]}" == *"dnsbl-2.uceprotect.net"* ||
      "${smail[blacklisted_zones]}" == *"dnsbl-3.uceprotect.net"* ]];then
if [[ "$YY" == "cn" ]];then
print -r -- "${Font_Yellow}说明：UCEPROTECT Level 2/3 是网段／ASN 级记录，不等于这个单独 IP 曾发送垃圾邮件。${Font_Suffix}"
else
print -r -- "${Font_Yellow}Note: UCEPROTECT Level 2/3 are netblock/ASN-level listings, not proof that this individual IP sent spam.${Font_Suffix}"
fi
fi
fi
if [[ -n "${smail[marked_zones]}" ]];then
if [[ "$YY" == "cn" ]];then
print -r -- "${Font_Yellow}其他标记：${smail[marked_zones]}${Font_Suffix}"
else
print -r -- "${Font_Yellow}Other listings: ${smail[marked_zones]}${Font_Suffix}"
fi
fi
}
show_tail(){
echo -ne "\r$(printf '%72s'|tr ' ' '=')\n"
echo -ne "\r$Font_I${stail[thanks]} $Font_Suffix\n"
echo -e ""
}
get_opts(){
OPTIND=1
while getopts "i:l:o:fjphE46" opt;do
case $opt in
4)if
[[ IPV4check -ne 0 ]]
then
IPV6check=0
else
ERRORcode=4
fi
;;
6)if
[[ IPV6check -ne 0 ]]
then
IPV4check=0
else
ERRORcode=6
fi
;;
f)fullIP=1
;;
h)show_help
;;
i)iface="$OPTARG"
local interface_pattern='^[A-Za-z0-9][A-Za-z0-9._:%-]*$'
if ! [[ "$iface" =~ $interface_pattern ]];then
ERRORcode=7
break
fi
useNIC=" --interface $iface"
CurlARG="$useNIC"
;;
j)mode_json=1
;;
l)YY=$(echo "$OPTARG"|tr '[:upper:]' '[:lower:]')
case "$YY" in
cn|en) ;;
*)ERRORcode=1
YY="cn"
break
;;
esac
;;
o)mode_output=1
outputfile="${OPTARG:A}"
[[ -z $outputfile ]]&&{
ERRORcode=1
break
}
[[ -e $outputfile || -L $outputfile ]]&&{
ERRORcode=10
break
}
local output_parent="${outputfile:h}"
[[ -d "$output_parent" && ! -L "$output_parent" && -w "$output_parent" ]]||{
ERRORcode=11
break
}
;;
p):
;;
E)YY="en"
;;
\?)ERRORcode=1
esac
done
shift $((OPTIND-1))
if (( $# > 1 ));then
ERRORcode=1
elif (( $# == 1 ));then
requested_ip="$1"
fi
CurlARG="$useNIC"
}
show_help(){
echo -ne "\r$shelp\n"
exit 0
}
open_report_output(){
[[ $output_fd -ge 0 ]]&&return 0
zmodload zsh/system 2>/dev/null||{
print -ru2 -- "ERROR: zsh/system is unavailable; cannot create the report safely."
return 69
}
sysopen -w -m 600 -o creat,excl,nofollow,cloexec,sync -u output_fd "$outputfile" 2>/dev/null||{
if [[ "$YY" == "cn" ]];then
print -ru2 -- "错误：无法以独占、安全模式创建报告文件：$outputfile"
else
print -ru2 -- "ERROR: cannot create the report path exclusively and safely: $outputfile"
fi
return 73
}
}
write_report_output(){
typeset ansi_report="$1"
typeset payload
case "$outputfile" in
*.[aA][nN][sS][iI])payload="$ansi_report"
;;
*.[jJ][sS][oO][nN])payload="$ipjson"
;;
*)payload=$(clean_ansi "$ansi_report" preserve)
esac
open_report_output||return $?
print -r -u "$output_fd" -- "$payload"||return 74
}
close_report_output(){
if [[ $output_fd -ge 0 ]];then
exec {output_fd}>&-
output_fd=-1
fi
}
save_json(){
local info_asn info_org info_lat info_lon info_dms info_map info_timezone
local info_city info_post info_subcode info_sub info_countrycode info_country
local info_continentcode info_continent info_regcountrycode info_regcountry info_type=""
local info_source="Check.Place upstream relay; MaxMind-labeled response"
if [[ $mode_lite -eq 0 ]];then
info_asn="${maxmind[asn]:-}"
info_org="${maxmind[org]:-}"
info_lat="${maxmind[lat]:-}"
info_lon="${maxmind[lon]:-}"
info_dms="${maxmind[dms]:-}"
info_map="${maxmind[map]:-}"
info_timezone="${maxmind[timezone]:-}"
info_city="${maxmind[city]:-}"
info_post="${maxmind[post]:-}"
info_subcode="${maxmind[subcode]:-}"
info_sub="${maxmind[sub]:-}"
info_countrycode="${maxmind[countrycode]:-}"
info_country="${maxmind[country]:-}"
info_continentcode="${maxmind[continentcode]:-}"
info_continent="${maxmind[continent]:-}"
info_regcountrycode="${maxmind[regcountrycode]:-}"
info_regcountry="${maxmind[regcountry]:-}"
else
info_source="IPinfo public demo widget"
info_asn="${ipinfo[asn]:-}"
info_org="${ipinfo[org]:-}"
info_lat="${ipinfo[lat]:-}"
info_lon="${ipinfo[lon]:-}"
info_dms="${ipinfo[dms]:-}"
info_map="${ipinfo[map]:-}"
info_timezone="${ipinfo[timezone]:-}"
info_city="${ipinfo[city]:-}"
info_post="${ipinfo[post]:-}"
info_subcode=""
info_sub=""
info_countrycode="${ipinfo[countrycode]:-}"
info_country="${ipinfo[country]:-}"
info_continentcode=""
info_continent="${ipinfo[continent]:-}"
info_regcountrycode="${ipinfo[regcountrycode]:-}"
info_regcountry="${ipinfo[regcountry]:-}"
fi
if [[ -n "$info_countrycode" && "$info_countrycode" != "null" ]];then
if [[ "$info_countrycode" == "$info_regcountrycode" ]];then
info_type=$(clean_ansi "${sbasic[type0]:-}")
else
info_type=$(clean_ansi "${sbasic[type1]:-}")
fi
fi

local reputation_enabled=false
scope_includes reputation&&reputation_enabled=true
local mail_port25=null
local mail_services='{}'
local service service_value
if scope_includes mail;then
case "${smail[local]:-0}" in
1)mail_port25=true
;;
2)mail_port25=null
;;
*)mail_port25=false
esac
for service in "${services[@]}";do
case "${smail[local]:-0}:${smailstatus[$service]:-false}" in
1:true)service_value=true
;;
2:*)service_value=null
;;
*)service_value=false
esac
mail_services=$(print -r -- "$mail_services"|jq -c --arg key "$service" --argjson value "$service_value" '. + {($key): $value}')||return 1
done
fi

local displayed_ip="${IPhide:-}"
[[ $fullIP -eq 1 ]]&&displayed_ip="${IP:-}"
local displayed_routing_prefix="${ripestat[prefix]:-}"
if [[ $fullIP -ne 1 && -n "$displayed_routing_prefix" ]];then
displayed_routing_prefix=$(mask_network_prefix "$displayed_routing_prefix")||displayed_routing_prefix=""
fi
ipjson=$(jq -n \
--arg head_ip "$displayed_ip" \
--arg head_repository "${shead[git]:-}" \
--arg head_time "${shead[time_raw]:-}" \
--arg head_version "${script_version:-}" \
--arg info_source "$info_source" \
--arg info_asn "$info_asn" --arg info_org "$info_org" \
--arg info_lat "$info_lat" --arg info_lon "$info_lon" \
--arg info_dms "$info_dms" --arg info_map "$info_map" \
--arg info_timezone "$info_timezone" --arg info_city "$info_city" \
--arg info_post "$info_post" --arg info_subcode "$info_subcode" \
--arg info_sub "$info_sub" --arg info_countrycode "$info_countrycode" \
--arg info_country "$info_country" --arg info_continentcode "$info_continentcode" \
--arg info_continent "$info_continent" --arg info_regcountrycode "$info_regcountrycode" \
--arg info_regcountry "$info_regcountry" --arg info_type "$info_type" \
--arg type_ipinfo_usage "$(clean_ansi "${ipinfo[susetype]:-}")" \
--arg type_ipregistry_usage "$(clean_ansi "${ipregistry[susetype]:-}")" \
--arg type_ipqs_usage "$(clean_ansi "${ipqs[susetype]:-}")" \
--arg type_ipapi_usage "$(clean_ansi "${ipapi[susetype]:-}")" \
--arg type_ip2_usage "$(clean_ansi "${ip2location[susetype]:-}")" \
--arg type_abuse_usage "$(clean_ansi "${abuseipdb[susetype]:-}")" \
--arg type_ipinfo_company "$(clean_ansi "${ipinfo[scomtype]:-}")" \
--arg type_ipregistry_company "$(clean_ansi "${ipregistry[scomtype]:-}")" \
--arg type_ipapi_company "$(clean_ansi "${ipapi[scomtype]:-}")" \
--arg type_ip2_company "$(clean_ansi "${ip2location[scomtype]:-}")" \
--arg score_ip2 "${ip2location[score]:-}" --arg score_scam "${scamalytics[score]:-}" \
--arg score_ipapi "${ipapi[score]:-}" --arg score_abuse "${abuseipdb[score]:-}" \
--arg score_ipqs "${ipqs[score]:-}" \
--arg band_ip2 "$(clean_ansi "${ip2location[risk]:-}")" \
--arg band_scam "$(clean_ansi "${scamalytics[risk]:-}")" \
--arg band_ipapi "$(clean_ansi "${ipapi[risk]:-}")" \

typeset -A browsers=(
[Chrome]="145.0.0.0 144.0.0.0 143.0.0.0 142.0.0.0 141.0.0.0 140.0.0.0"
[Firefox]="147.0 146.0 145.0 144.0 143.0 142.0 141.0 140.0")
generate_random_user_agent(){
local -a browsers_keys=(Chrome Firefox)
local random_browser_index=$((RANDOM%${#browsers_keys[@]}))
local browser=${browsers_keys[random_browser_index]}
case $browser in
Chrome)local versions=(${browsers[Chrome]})
local version=${versions[RANDOM%${#versions[@]}]}
UA_Browser="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/$version Safari/537.36"
;;
Firefox)local versions=(${browsers[Firefox]})
local version=${versions[RANDOM%${#versions[@]}]}
UA_Browser="Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:$version) Gecko/20100101 Firefox/$version"
esac
}
adapt_locale(){
local ifunicode=$(printf '\u2800')
[[ ${#ifunicode} -gt 3 ]]&&export LC_CTYPE=en_US.UTF-8 2>/dev/null
}
check_reference_files(){
local reference_file
for reference_file in "$DNSBL_FILE" "$REF_DIR/iso3166.json";do
[[ -f "$reference_file" && -r "$reference_file" && ! -L "$reference_file" ]]||{
print -ru2 -- "ERROR: unsafe or missing reference file: $reference_file"
return 66
}
done
}
is_valid_ipv4(){
local ip=$1
if [[ $ip =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]];then
local -a octets=("${(@s:.:)ip}")
for octet in "${octets[@]}";do
if ((octet<0||octet>255));then
IPV4work=0
return 1
fi
done
IPV4work=1
return 0
else
IPV4work=0
return 1
fi
}
is_private_ipv4(){
local ip_address=$1
if [[ -z $ip_address ]];then
return 0
fi
local ipv4_pattern='^([0-9]{1,3}\.){3}[0-9]{1,3}$'
[[ $ip_address =~ $ipv4_pattern ]]||return 0
local -a parts=("${(@s:.:)ip_address}")
local first=$(( 10#${parts[0]} ))
local second=$(( 10#${parts[1]} ))
local third=$(( 10#${parts[2]} ))
if (( first == 0 || first == 10 || first == 127 || first >= 224 ||
      (first == 100 && second >= 64 && second <= 127) ||
      (first == 169 && second == 254) ||
      (first == 172 && second >= 16 && second <= 31) ||
      (first == 192 && second == 168) ||
      (first == 192 && second == 0 && (third == 0 || third == 2)) ||
      (first == 192 && second == 88 && third == 99) ||
      (first == 198 && (second == 18 || second == 19)) ||
      (first == 198 && second == 51 && third == 100) ||
      (first == 203 && second == 0 && third == 113) ));then
return 0
fi
return 1
}
get_ipv4(){
local response
IPV4=""
local API_NET=("https://ipinfo.io/ip" "https://myip.check.place" "https://ip.sb" "https://ping0.cc" "https://icanhazip.com" "https://api64.ipify.org" "https://ifconfig.co" "https://ident.me")
for p in "${API_NET[@]}";do
response=$(curl_safe $CurlARG -s4 --max-time 2 "$p")
local curl_status=$?
if (( curl_status == 0 ))&&is_valid_ipv4 "$response"&&! is_private_ipv4 "$response";then
IPV4="$response"
break
fi
done
}
hide_ipv4(){
if [[ -n $1 ]];then
local -a ip_parts=("${(@s:.:)1}")
IPhide="${ip_parts[0]}.${ip_parts[1]}.*.*"
else
IPhide=""
fi
}
mask_network_prefix(){
typeset prefix="$1"
typeset address="${prefix%/*}"
typeset prefix_length="${prefix##*/}"
[[ -n "$address" && "$prefix" != "$address" && "$prefix_length" == <-> ]]||return 1
if [[ "$address" == *:* ]];then
typeset -a parts=("${(@s/:/)address}")
[[ -n "${parts[0]}" && -n "${parts[1]}" ]]||{
print -rn -- "*::/$prefix_length"
return 0
}
print -rn -- "${parts[0]}:${parts[1]}:*::/$prefix_length"
else
typeset -a parts=("${(@s:.:)address}")
(( ${#parts[@]} == 4 ))||return 1
print -rn -- "${parts[0]}.${parts[1]}.*.*/$prefix_length"
fi
}
is_valid_ipv6(){
local ip=$1
if [[ $ip =~ ^([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}$ || $ip =~ ^([0-9a-fA-F]{1,4}:){1,7}:$ || $ip =~ ^:([0-9a-fA-F]{1,4}:){1,7}$ || $ip =~ ^([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}$ || $ip =~ ^([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}$ || $ip =~ ^([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}$ || $ip =~ ^([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}$ || $ip =~ ^([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}$ || $ip =~ ^[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})$ || $ip =~ ^:((:[0-9a-fA-F]{1,4}){1,7}|:)$ || $ip =~ ^fe80:(:[0-9a-fA-F]{0,4}){0,4}%[0-9a-zA-Z]{1,}$ || $ip =~ ^::(ffff(:0{1,4}){0,1}:){0,1}(([0-9]{1,3}\.){3}[0-9]{1,3})$ || $ip =~ ^([0-9a-fA-F]{1,4}:){1,4}:(([0-9]{1,3}\.){3}[0-9]{1,3})$ ]];then
IPV6work=1
return 0
else
IPV6work=0
return 1
fi
}
is_private_ipv6(){
local address=$1
if [[ -z $address ]];then
return 0
fi
if [[ $address == :: || $address == ::1 ]]||[[ $address =~ ^f[cd][0-9a-f]{2}: ]]||[[ $address =~ ^fe[89ab][0-9a-f]: ]]||[[ $address =~ ^ff[0-9a-f]{2}: ]]||[[ $address =~ ^2001:db8: ]]||[[ $address =~ ^::ffff: ]];then
return 0
fi
return 1
}
get_ipv6(){
local response
IPV6=""
local API_NET=("https://myip.check.place" "https://ip.sb" "https://ping0.cc" "https://icanhazip.com" "https://api64.ipify.org" "https://ifconfig.co" "https://ident.me")
for p in "${API_NET[@]}";do
response=$(curl_safe $CurlARG -s6 --max-time 2 "$p")
local curl_status=$?
response="${response%$'\n'}"
if (( curl_status == 0 ))&&is_valid_ipv6 "$response"&&! is_private_ipv6 "$response";then
IPV6="$response"
break
fi
done
}

prepare_explicit_target(){
case "$query_scope" in
reputation|dnsbl) ;;
*)ERRORcode=62
return 1
esac
if is_valid_ipv4 "$requested_ip";then
if is_private_ipv4 "$requested_ip";then
ERRORcode=2
return 1
fi
if [[ $IPV4check -eq 0 ]];then
ERRORcode=63
return 1
fi
IPV4="$requested_ip"
IPV4work=1
IPV4check=1
IPV6=""
IPV6work=0
IPV6check=0
return 0
fi
if is_valid_ipv6 "$requested_ip";then
if is_private_ipv6 "$requested_ip";then
ERRORcode=2
return 1
fi
if [[ $IPV6check -eq 0 ]];then
ERRORcode=63
return 1
fi
IPV6="$requested_ip"
IPV6work=1
IPV6check=1
IPV4=""
IPV4work=0
IPV4check=0
return 0
fi
ERRORcode=2
return 1
}

hide_ipv6(){
if [[ -n $1 ]];then
local expanded_ip=$(echo "$1"|sed 's/::/:0000:0000:0000:0000:0000:0000:0000:0000:/g'|cut -d ':' -f1-8)
local -a ip_parts=("${(@s.:.)expanded_ip}")
while [ ${#ip_parts[@]} -lt 8 ];do
ip_parts+=(0000)
done
IPhide="${ip_parts[0]:-0}:${ip_parts[1]:-0}:${ip_parts[2]:-0}:*:*:*:*:*"
IPhide=$(echo "$IPhide"|sed 's/:0\{1,\}/:/g'|sed 's/::\+/:/g')
else
IPhide=""
fi
}
calc_padding(){
local input_text="$1"
local total_width=$2
local title_length=$(display_width "$input_text")
local left_padding=$(((total_width-title_length)/2))
if [[ $left_padding -gt 0 ]];then
PADDING=$(printf '%*s' $left_padding)
else
PADDING=""
fi
}
generate_dms(){
local lat=$1
local lon=$2
if ! is_signed_decimal "$lat"||! is_signed_decimal "$lon";then
echo ""
return
fi
convert_single(){
local coord=$1
local direction=$2
local fixed_coord=$(echo "$coord"|sed 's/\.$/.0/')
local degrees=$(echo "$fixed_coord"|cut -d'.' -f1)
local fractional="0.$(echo "$fixed_coord"|cut -d'.' -f2)"
local minutes=$(echo "$fractional * 60"|bc -l|cut -d'.' -f1)
local seconds_fractional="0.$(echo "$fractional * 60"|bc -l|cut -d'.' -f2)"
local seconds=$(echo "$seconds_fractional * 60"|bc -l|awk '{printf "%.0f", $1}')
echo "$degrees°$minutes′$seconds″$direction"
}
local lat_dir='N'
if [[ $(echo "$lat < 0"|bc -l) -eq 1 ]];then
lat_dir='S'
lat=$(echo "$lat * -1"|bc -l)
fi
local lon_dir='E'
if [[ $(echo "$lon < 0"|bc -l) -eq 1 ]];then
lon_dir='W'
lon=$(echo "$lon * -1"|bc -l)
fi
local lat_dms=$(convert_single $lat $lat_dir)
local lon_dms=$(convert_single $lon $lon_dir)
echo "$lon_dms, $lat_dms"
}
generate_googlemap_url(){
local lat=$1
local lon=$2
local radius=$3
if ! is_signed_decimal "$lat"||! is_signed_decimal "$lon"||! is_nonnegative_decimal "$radius";then
echo ""
return
fi
local zoom_level=15
if [[ $radius -gt 1000 ]];then
zoom_level=12
elif [[ $radius -gt 500 ]];then
zoom_level=13
elif [[ $radius -gt 250 ]];then
zoom_level=14
fi
echo "https://check.place/$lat,$lon,$zoom_level,$YY"
}

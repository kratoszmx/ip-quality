#!/bin/zsh

# Derived from xykt/IPQuality. See UPSTREAM.md and LICENSE before modifying or
# redistributing this file.
emulate -LR zsh
setopt KSH_ARRAYS SH_WORD_SPLIT NO_NOMATCH NO_CASE_MATCH
unsetopt RCS GLOBAL_RCS
umask 077
# Display widths and byte validation need UTF-8 whatever the caller locale is.
export LC_ALL=en_US.UTF-8

script_version="v2026-10-18-standalone.33"
typeset SCRIPT_DIR="${0:A:h:h}"
typeset REF_DIR="$SCRIPT_DIR/ref"
typeset DNSBL_FILE="$REF_DIR/dnsbl.list"
# Load order: shared helpers, source policy, providers (parser + adapter), report.
typeset -a reporter_modules=(
common/json_values.jq common/provider_values.zsh common/http_request.zsh common/terminal.zsh
providers/credentials.zsh providers/check_place.zsh providers/query_route.zsh providers/selection.zsh
providers/ipinfo.zsh providers/ipregistry.zsh providers/scamalytics.zsh providers/ipapi.zsh
providers/ipwhois.zsh providers/dbip.zsh providers/cloudflare.zsh providers/abuseipdb.zsh
providers/ip2location.zsh providers/ipdata.zsh providers/ipqualityscore.zsh providers/ping0.zsh
providers/ripestat.zsh providers/shodan_internetdb.zsh providers/mail.zsh providers/dnsbl.zsh
report/labels.zsh report/reputation.zsh report/sections.zsh report/json.zsh)
typeset local_library
for local_library in "${reporter_modules[@]}";do
local_library="$SCRIPT_DIR/$local_library"
[[ -f "$local_library" && -r "$local_library" && ! -L "$local_library" ]]||{
print -ru2 -- "ERROR: unsafe or missing local library: $local_library"
exit 66
}
[[ "${local_library:e}" == zsh ]]&&source "$local_library"
done
typeset query_scope="reputation"
typeset network_lookup_confirmed=0
typeset plan_only=0
typeset help_requested=0
typeset version_requested=0
typeset dnsbl_concurrency=50
typeset ipqs_dns=auto
typeset requested_ip=""
typeset -a short_args=()
Font_B=$'\033[1m'
Font_D=$'\033[2m'

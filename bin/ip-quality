set_report_time(){
if [[ "$YY" == "cn" ]];then
shead[time_raw]=$(TZ="Asia/Shanghai" date +"%Y-%m-%d %H:%M:%S CST")
else
shead[time_raw]=$(date -u +"%Y-%m-%d %H:%M:%S UTC")
fi
shead[time]="${shead[time_label]}${shead[time_raw]}"
}
show_progress_bar(){
print -ru2 -- "[ip-quality] $(clean_ansi "$1")"
}

scope_includes(){
local requested="$1"
[[ "$query_scope" == "full" || "$query_scope" == "$requested" ||
   ( "$query_scope" == "mail-dnsbl" && ( "$requested" == "mail" || "$requested" == "dnsbl" ) ) ]]
}

is_nonnegative_decimal(){
local decimal_pattern='^[0-9]+([.][0-9]+)?$'
[[ "$1" =~ $decimal_pattern ]]
}

is_signed_decimal(){
local decimal_pattern='^-?[0-9]+([.][0-9]+)?$'
[[ "$1" =~ $decimal_pattern ]]
}

curl_safe(){
command curl -q "$@"
}

# Feed credential-bearing curl options over stdin so API keys never appear in
# process arguments, Git configuration, or the report. Callers validate every
# interpolated key and IP before reaching these helpers.
curl_with_secret_url(){
typeset secret_url="$1"
shift
print -r -- "url = \"$secret_url\""|curl_safe "$@" --config -
}

curl_with_secret_header(){
typeset header_name="$1"
typeset header_value="$2"
typeset endpoint="$3"
shift 3
{
print -r -- "header = \"$header_name: $header_value\""
print -r -- "url = \"$endpoint\""
}|curl_safe "$@" --config -
}

typeset -g PROVIDER_RESPONSE_BODY=""
typeset -g PROVIDER_RESPONSE_STATUS="unknown"

provider_fetch_public_json(){
emulate -LR zsh
setopt SH_WORD_SPLIT
typeset address_family="$1"
typeset endpoint="$2"
typeset maximum_bytes="${3:-262144}"
if (( $# >= 3 ));then shift 3;else shift 2;fi
typeset wire_response curl_exit http_code response_body

PROVIDER_RESPONSE_BODY=""
PROVIDER_RESPONSE_STATUS="unknown"
wire_response=$(curl_safe $CurlARG -sS -L -$address_family -m 10 \
  --max-filesize "$maximum_bytes" --write-out $'\n%{http_code}' "$@" "$endpoint" 2>/dev/null)
curl_exit=$?
if (( curl_exit != 0 )) || [[ "$wire_response" != *$'\n'* ]];then
PROVIDER_RESPONSE_STATUS="network_error"
return 1
fi
http_code="${wire_response##*$'\n'}"
response_body="${wire_response%$'\n'*}"
if [[ "$http_code" != [0-9][0-9][0-9] ]] || (( 10#$http_code < 200 || 10#$http_code > 299 ));then
PROVIDER_RESPONSE_STATUS=$(provider_http_failure_status "$http_code" "$response_body")
return 1
fi
if ! provider_json_is_object "$response_body";then
PROVIDER_RESPONSE_STATUS="invalid_response"
return 1
fi
PROVIDER_RESPONSE_BODY="$response_body"
PROVIDER_RESPONSE_STATUS="ok"
return 0
}

styled_provider_type(){
typeset raw="${1:l}"
case "$raw" in
business|corporate)print -rn -- "${stype[business]}"
;;
isp|consumer|residential)print -rn -- "${stype[isp]}"
;;
mobile)print -rn -- "${stype[mobile]}"
;;
hosting|"data center")print -rn -- "${stype[hosting]}"
;;
education)print -rn -- "${stype[education]}"
;;
government)print -rn -- "${stype[government]}"
;;
inactive|reserved)print -rn -- "${stype[reserved]}"
;;
""|null|unknown)print -rn -- "${stype[unknown]}"
;;
*)print -rn -- "${stype[other]}"
esac
}

parse_cli(){
legacy_args=()
while (( $# > 0 ));do
case "$1" in
--confirm-network-lookup)network_lookup_confirmed=1
;;
--plan)plan_only=1
;;
--self-test)self_test_requested=1
;;
--help|-h)help_requested=1
;;
--version)version_requested=1
;;
--scope)
(( $# >= 2 ))||{
print -ru2 -- "ERROR: --scope requires a value."
return 64
}
query_scope="$2"
shift
;;
--scope=*)query_scope="${1#*=}"
;;
--dnsbl-concurrency)
(( $# >= 2 ))||{
print -ru2 -- "ERROR: --dnsbl-concurrency requires a value."
return 64
}
dnsbl_concurrency="$2"
shift
;;
--dnsbl-concurrency=*)dnsbl_concurrency="${1#*=}"
;;
-x|-x*|-y|-y*|-M|-M*)
print -ru2 -- "ERROR: proxy arguments, automatic installers, and remote menus are disabled."
print -ru2 -- "Use bin/test-clash-leaf for a supervised isolated proxy path."
return 64
;;
--)shift
legacy_args+=("$@")
break
;;
*)legacy_args+=("$1")
esac
shift
done
case "$query_scope" in
reputation|dnsbl|mail|mail-dnsbl|full) ;;
*)print -ru2 -- "ERROR: unsupported scope: $query_scope"
return 64
esac
if [[ "$dnsbl_concurrency" != <-> ]]||(( dnsbl_concurrency < 1 || dnsbl_concurrency > 50 ));then
print -ru2 -- "ERROR: DNSBL concurrency must be an integer from 1 through 50."
return 64
fi
}

print_query_plan(){
print -r -- "IP Quality query plan (no network access has occurred)"
print -r -- "  scope: $query_scope"
print -r -- "  DNSBL concurrency cap: $dnsbl_concurrency"
print -r -- "  output: masked IP by default; local stdout/file only"
print -r -- "  telemetry/report upload/remote code: disabled"
scope_includes reputation&&print -r -- "  reputation sources: ipapi.is, Cloudflare IP Intelligence (when configured), Ping0, RIPEstat, Shodan InternetDB, plus configured Ipregistry/IPQS APIs"
scope_includes reputation&&print -r -- "  public website demos: DB-IP page + one visitor-egress lookup (must match target); IPWHOIS one target lookup; no account, no guaranteed quota or availability"
scope_includes reputation&&print -r -- "  supplementary sources: IPinfo public demo widget plus named Check.Place relays (MaxMind-labeled, Scamalytics, AbuseIPDB, IP2Location, ipdata, IPQualityScore)"
scope_includes reputation&&print -r -- "  Ping0 limitation: the official free /geo endpoint exposes IP/location/ASN/organization, not a risk score"
scope_includes reputation&&print -r -- "  Cloudflare: IP Intelligence threat categories, no numeric IP score; legacy Threat Score is retired (constant zero). RIPEstat reports routing; Shodan InternetDB reports public exposure"
scope_includes mail&&print -r -- "  mail sources: public MX DNS plus bounded SMTP greeting probes"
scope_includes dnsbl&&print -r -- "  DNSBL sources: vendored $DNSBL_FILE (up to $dnsbl_concurrency concurrent DNS lookups)"
print -r -- ""
print -r -- "Each selected third party can observe the tested egress IP and query time."
print -r -- "Run live only with: --confirm-network-lookup"
}

require_dependencies(){
local -a required=(curl jq)
scope_includes reputation&&required+=(bc)
scope_includes mail&&required+=(dig nc)
scope_includes dnsbl&&required+=(dig xargs)
local -a missing=()
local dependency
for dependency in "${required[@]}";do
command -v "$dependency" >/dev/null 2>&1||missing+=("$dependency")
done
if (( ${#missing[@]} > 0 ));then
print -ru2 -- "ERROR: missing required commands: ${missing[*]}"
print -ru2 -- "No installer was run. Install them through the repository's env workflow."
return 69
fi
}


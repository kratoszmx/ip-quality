set_report_time(){
if [[ "$YY" == "cn" ]];then
shead[time_raw]=$(TZ="Asia/Shanghai" date +"%Y-%m-%d %H:%M:%S CST")
else
shead[time_raw]=$(date -u +"%Y-%m-%d %H:%M:%S UTC")
fi
shead[time]="${shead[time_label]}${shead[time_raw]}"
}
show_progress(){
print -ru2 -- "[ip-quality] $1"
}

scope_includes(){
local requested="$1"
[[ "$query_scope" == "full" || "$query_scope" == "$requested" ||
   ( "$query_scope" == "mail-dnsbl" && ( "$requested" == "mail" || "$requested" == "dnsbl" ) ) ]]
}

is_nonnegative_decimal(){
local decimal_pattern='^[0-9]+([.][0-9]+)?$'
[[ "$1" =~ $decimal_pattern ]]
}

is_signed_decimal(){
local decimal_pattern='^-?[0-9]+([.][0-9]+)?$'
[[ "$1" =~ $decimal_pattern ]]
}

typeset -g PROVIDER_RESPONSE_BODY=""
typeset -g PROVIDER_RESPONSE_STATUS="unknown"

provider_fetch_public_json(){
emulate -LR zsh
setopt SH_WORD_SPLIT
typeset address_family="$1"
typeset endpoint="$2"
typeset maximum_bytes="${3:-262144}"
if (( $# >= 3 ));then shift 3;else shift 2;fi
typeset wire_response response_body

PROVIDER_RESPONSE_BODY=""
PROVIDER_RESPONSE_STATUS="unknown"
wire_response=$(curl -q $CurlARG -sS -L -$address_family -m 10 \
  --max-filesize "$maximum_bytes" --write-out $'\n%{http_code}' "$@" "$endpoint" 2>/dev/null)
provider_decode_http_response "$wire_response" "$?"
PROVIDER_RESPONSE_STATUS="${provider_http_response[status]}"
[[ "$PROVIDER_RESPONSE_STATUS" == ok ]]||return 1
response_body="${provider_http_response[body]}"
if ! provider_json_is_object "$response_body";then
PROVIDER_RESPONSE_STATUS="invalid_response"
return 1
fi
PROVIDER_RESPONSE_BODY="$response_body"
PROVIDER_RESPONSE_STATUS="ok"
return 0
}

set_cli_error(){
(( ERRORcode ))||ERRORcode=$1
}

# One pass over long options, getopts-style short clusters (-4fj, -len, -l en)
# and at most one positional target. Long-option errors return 64 in English;
# short-option errors keep the first localized ERRORcode for after set_language.
parse_cli(){
local argument cluster option value output_parent
local interface_pattern='^[A-Za-z0-9][A-Za-z0-9._:%-]*$'
local -a positional=()
while (( $# > 0 ));do
argument="$1"
shift
case "$argument" in
--confirm-network-lookup)network_lookup_confirmed=1 ;;
--plan)plan_only=1 ;;
--help)help_requested=1 ;;
--version)version_requested=1 ;;
--scope|--sources|--ipqs-dns|--dnsbl-concurrency|--scope=*|--sources=*|--ipqs-dns=*|--dnsbl-concurrency=*)
if [[ "$argument" == *=* ]];then
value="${argument#*=}"
argument="${argument%%=*}"
else
(( $# > 0 ))||{ print -ru2 -- "ERROR: $argument requires a value."; return 64; }
value="$1"
shift
fi
case "$argument" in
--scope)query_scope="$value" ;;
--sources)source_selection="$value" ;;
--ipqs-dns)ipqs_dns="$value" ;;
--dnsbl-concurrency)dnsbl_concurrency="$value"
esac
;;
-x|-x*|-y|-y*|-M|-M*)
print -ru2 -- "ERROR: proxy arguments, automatic installers, and remote menus are disabled."
print -ru2 -- "Use bin/test-clash-leaf for a supervised isolated proxy path."
return 64
;;
--)positional+=("$@")
break
;;
--*)set_cli_error 1 ;;
-?*)
cluster="${argument#-}"
while [[ -n "$cluster" ]];do
option="${cluster:0:1}"
cluster="${cluster:1}"
value=""
if [[ "$option" == [ilo] ]];then
if [[ -n "$cluster" ]];then
value="$cluster"
cluster=""
elif (( $# > 0 ));then
value="$1"
shift
else
set_cli_error 1
break
fi
fi
case "$option" in
4)if (( IPV4check ));then IPV6check=0;else set_cli_error 4;fi ;;
6)if (( IPV6check ));then IPV4check=0;else set_cli_error 6;fi ;;
f)fullIP=1 ;;
h)help_requested=1 ;;
j)mode_json=1 ;;
E)YY="en" ;;
i)
if [[ "$value" =~ $interface_pattern ]];then
useNIC=" --interface $value"
else
set_cli_error 7
fi
;;
l)
case "${value:l}" in
cn|en)YY="${value:l}" ;;
*)set_cli_error 1
esac
;;
o)
mode_output=1
outputfile="${value:A}"
output_parent="${outputfile:h}"
if [[ -z "$value" ]];then
set_cli_error 1
elif [[ -e "$outputfile" || -L "$outputfile" ]];then
set_cli_error 10
elif [[ ! -d "$output_parent" || -L "$output_parent" || ! -w "$output_parent" ]];then
set_cli_error 11
fi
;;
*)set_cli_error 1
esac
done
;;
*)positional+=("$argument")
esac
done
if (( ${#positional[@]} > 1 ));then
set_cli_error 1
elif (( ${#positional[@]} == 1 ));then
requested_ip="${positional[0]}"
fi
CurlARG="$useNIC"
case "$query_scope" in
reputation|dnsbl|mail|mail-dnsbl|full) ;;
*)print -ru2 -- "ERROR: unsupported scope: $query_scope"
return 64
esac
reputation_choose_sources "$source_selection"||return $?
case "$ipqs_dns" in
auto|system) ;;
alidns)
if [[ -n "${IPQUALITY_ISOLATED_EGRESS:-}${http_proxy:-}${https_proxy:-}${all_proxy:-}${HTTP_PROXY:-}${HTTPS_PROXY:-}${ALL_PROXY:-}" ]];then
print -ru2 -- "ERROR: --ipqs-dns alidns requires a direct route without proxy variables."
return 64
fi
;;
*)print -ru2 -- "ERROR: --ipqs-dns must be auto, system or alidns."; return 64 ;;
esac
if [[ "$dnsbl_concurrency" != <-> ]]||(( dnsbl_concurrency < 1 || dnsbl_concurrency > 50 ));then
print -ru2 -- "ERROR: DNSBL concurrency must be an integer from 1 through 50."
return 64
fi
}

print_query_plan(){
print -r -- "IP Quality query plan (no network access has occurred)"
print -r -- "  scope: $query_scope"
print -r -- "  DNSBL concurrency cap: $dnsbl_concurrency"
print -r -- "  output: masked IP by default; local stdout/file only"
print -r -- "  telemetry/report upload/remote code: disabled"
[[ -n "$requested_ip" ]]&&print -r -- "  target: explicit IP, sent to providers as a lookup parameter"
if scope_includes reputation;then
print -r -- "  selected source IDs: ${(j:,:)selected_reputation_sources[@]}"
print -r -- "  reputation lookups use selected IDs; automatic egress discovery is separate from this catalogue"
[[ "$source_selection" == independent ]]&&print -r -- "  independent mode: no Check.Place requests; IPQS requires its official API key"
if reputation_source_selected ipqs;then
[[ "$ipqs_dns" == auto ]]&&print -r -- "  IPQS DNS: automatic AliDNS HTTPS resolution for direct IPv4; initial IPv6/proxy requests keep their existing resolver"
[[ "$ipqs_dns" == alidns ]]&&print -r -- "  IPQS DNS: AliDNS DoH (https://dns.alidns.com/dns-query); resolver receives IPQS hostname, not the API key or target; system DNS is unchanged"
fi
if reputation_source_selected ipqs||reputation_source_selected cloudflare;then
print -r -- "  targeted IPQS/Cloudflare APIs: selected route first; connectivity failure before HTTP permits one direct IPv4 fallback, querying the same target IP"
print -r -- "  fallback privacy: the same provider also sees the system-route egress; egress discovery and visitor/self demos never switch routes"
reputation_source_selected ipqs&&print -r -- "  IPQS direct fallback uses AliDNS (https://dns.alidns.com/dns-query); this resolver receives the IPQS hostname only, not the API key or target"
fi
print -r -- "  reputation sources:"
reputation_source_disclosure_lines "$requested_ip"
fi
scope_includes mail&&print -r -- "  mail sources: public MX DNS plus bounded SMTP greeting probes"
scope_includes dnsbl&&print -r -- "  DNSBL sources: vendored $DNSBL_FILE (up to $dnsbl_concurrency concurrent DNS lookups)"
print -r -- ""
print -r -- "Each selected third party can observe the tested egress IP and query time."
print -r -- "Run live only with: --confirm-network-lookup"
}

require_dependencies(){
local -a required=(curl jq)
scope_includes reputation&&required+=(bc)
scope_includes mail&&required+=(dig nc)
scope_includes dnsbl&&required+=(dig xargs)
local -a missing=()
local dependency
for dependency in "${required[@]}";do
command -v "$dependency" >/dev/null 2>&1||missing+=("$dependency")
done
if (( ${#missing[@]} > 0 ));then
print -ru2 -- "ERROR: missing required commands: ${missing[*]}"
print -ru2 -- "No installer was run. Install them through the repository's env workflow."
return 69
fi
}

check_reference_files(){
local reference_file
for reference_file in "$DNSBL_FILE" "$REF_DIR/iso3166.json" "$REF_DIR/non_public_ipv4.txt";do
[[ -f "$reference_file" && -r "$reference_file" && ! -L "$reference_file" ]]||{
print -ru2 -- "ERROR: unsafe or missing reference file: $reference_file"
return 66
}
done
}
is_valid_ipv4(){
local ip=$1
if [[ $ip =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]];then
local -a octets=("${(@s:.:)ip}")
for octet in "${octets[@]}";do
if ((octet<0||octet>255));then
IPV4work=0
return 1
fi
done
IPV4work=1
return 0
else
IPV4work=0
return 1
fi
}
# Non-public ranges come from ref/non_public_ipv4.txt, shared with prefix
# sampling. An unreadable list fails closed: every address counts as non-public.
typeset -ga non_public_ipv4_ranges=()
is_private_ipv4(){
local ip_address=$1
local ipv4_pattern='^([0-9]{1,3}\.){3}[0-9]{1,3}$'
[[ -n $ip_address && $ip_address =~ $ipv4_pattern ]]||return 0
if (( ${#non_public_ipv4_ranges[@]} == 0 ));then
local line
[[ -f "$REF_DIR/non_public_ipv4.txt" && -r "$REF_DIR/non_public_ipv4.txt" ]]||return 0
while IFS= read -r line;do
[[ -z "$line" || "$line" == \#* ]]||non_public_ipv4_ranges+=("$line")
done < "$REF_DIR/non_public_ipv4.txt"
fi
local -a parts=("${(@s:.:)ip_address}") network
local address=$(( (10#${parts[0]} << 24) | (10#${parts[1]} << 16) | (10#${parts[2]} << 8) | 10#${parts[3]} ))
local range prefix_length mask
for range in "${non_public_ipv4_ranges[@]}";do
network=("${(@s:.:)${range%/*}}")
prefix_length="${range#*/}"
mask=$(( prefix_length == 0 ? 0 : (0xFFFFFFFF << (32 - prefix_length)) & 0xFFFFFFFF ))
(( (address & mask) == (((network[0] << 24) | (network[1] << 16) | (network[2] << 8) | network[3]) & mask) ))&&return 0
done
return 1
}
get_ipv4(){
local response
IPV4=""
local API_NET=("https://ipinfo.io/ip" "https://ip.sb" "https://ping0.cc" "https://icanhazip.com" "https://api64.ipify.org" "https://ifconfig.co" "https://ident.me")
for p in "${API_NET[@]}";do
response=$(curl -q $CurlARG -s4 --max-time 2 "$p")
local curl_status=$?
if (( curl_status == 0 ))&&is_valid_ipv4 "$response"&&! is_private_ipv4 "$response";then
IPV4="$response"
break
fi
done
}
hide_ipv4(){
if [[ -n $1 ]];then
local -a ip_parts=("${(@s:.:)1}")
IPhide="${ip_parts[0]}.${ip_parts[1]}.*.*"
else
IPhide=""
fi
}
mask_network_prefix(){
typeset prefix="$1"
typeset address="${prefix%/*}"
typeset prefix_length="${prefix##*/}"
[[ -n "$address" && "$prefix" != "$address" && "$prefix_length" == <-> ]]||return 1
if [[ "$address" == *:* ]];then
typeset -a parts=("${(@s/:/)address}")
[[ -n "${parts[0]}" && -n "${parts[1]}" ]]||{
print -rn -- "*::/$prefix_length"
return 0
}
print -rn -- "${parts[0]}:${parts[1]}:*::/$prefix_length"
else
typeset -a parts=("${(@s:.:)address}")
(( ${#parts[@]} == 4 ))||return 1
print -rn -- "${parts[0]}.${parts[1]}.*.*/$prefix_length"
fi
}
is_valid_ipv6(){
local ip=$1
if [[ $ip =~ ^([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}$ || $ip =~ ^([0-9a-fA-F]{1,4}:){1,7}:$ || $ip =~ ^:([0-9a-fA-F]{1,4}:){1,7}$ || $ip =~ ^([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}$ || $ip =~ ^([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}$ || $ip =~ ^([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}$ || $ip =~ ^([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}$ || $ip =~ ^([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}$ || $ip =~ ^[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})$ || $ip =~ ^:((:[0-9a-fA-F]{1,4}){1,7}|:)$ || $ip =~ ^fe80:(:[0-9a-fA-F]{0,4}){0,4}%[0-9a-zA-Z]{1,}$ || $ip =~ ^::(ffff(:0{1,4}){0,1}:){0,1}(([0-9]{1,3}\.){3}[0-9]{1,3})$ || $ip =~ ^([0-9a-fA-F]{1,4}:){1,4}:(([0-9]{1,3}\.){3}[0-9]{1,3})$ ]];then
IPV6work=1
return 0
else
IPV6work=0
return 1
fi
}
is_private_ipv6(){
local address=$1
if [[ -z $address ]];then
return 0
fi
if [[ $address == :: || $address == ::1 ]]||[[ $address =~ ^f[cd][0-9a-f]{2}: ]]||[[ $address =~ ^fe[89ab][0-9a-f]: ]]||[[ $address =~ ^ff[0-9a-f]{2}: ]]||[[ $address =~ ^2001:db8: ]]||[[ $address =~ ^::ffff: ]];then
return 0
fi
return 1
}
get_ipv6(){
local response
IPV6=""
local API_NET=("https://ip.sb" "https://ping0.cc" "https://icanhazip.com" "https://api64.ipify.org" "https://ifconfig.co" "https://ident.me")
for p in "${API_NET[@]}";do
response=$(curl -q $CurlARG -s6 --max-time 2 "$p")
local curl_status=$?
response="${response%$'\n'}"
if (( curl_status == 0 ))&&is_valid_ipv6 "$response"&&! is_private_ipv6 "$response";then
IPV6="$response"
break
fi
done
}

prepare_explicit_target(){
case "$query_scope" in
reputation|dnsbl) ;;
*)ERRORcode=62
return 1
esac
if is_valid_ipv4 "$requested_ip";then
if is_private_ipv4 "$requested_ip";then
ERRORcode=2
return 1
fi
if [[ $IPV4check -eq 0 ]];then
ERRORcode=63
return 1
fi
IPV4="$requested_ip"
IPV4work=1
IPV4check=1
IPV6=""
IPV6work=0
IPV6check=0
return 0
fi
if is_valid_ipv6 "$requested_ip";then
if is_private_ipv6 "$requested_ip";then
ERRORcode=2
return 1
fi
if [[ $IPV6check -eq 0 ]];then
ERRORcode=63
return 1
fi
IPV6="$requested_ip"
IPV6work=1
IPV6check=1
IPV4=""
IPV4work=0
IPV4check=0
return 0
fi
ERRORcode=2
return 1
}

hide_ipv6(){
if [[ -n $1 ]];then
local expanded_ip=$(echo "$1"|sed 's/::/:0000:0000:0000:0000:0000:0000:0000:0000:/g'|cut -d ':' -f1-8)
local -a ip_parts=("${(@s.:.)expanded_ip}")
while [ ${#ip_parts[@]} -lt 8 ];do
ip_parts+=(0000)
done
IPhide="${ip_parts[0]:-0}:${ip_parts[1]:-0}:${ip_parts[2]:-0}:*:*:*:*:*"
IPhide=$(echo "$IPhide"|sed 's/:0\{1,\}/:/g'|sed 's/::\+/:/g')
else
IPhide=""
fi
}
calc_padding(){
local input_text="$1"
local total_width=$2
local title_length=$(display_width "$input_text")
local left_padding=$(((total_width-title_length)/2))
if [[ $left_padding -gt 0 ]];then
PADDING=$(printf '%*s' $left_padding)
else
PADDING=""
fi
}
generate_dms(){
local lat=$1
local lon=$2
if ! is_signed_decimal "$lat"||! is_signed_decimal "$lon";then
echo ""
return
fi
print -r -- "$(format_dms_coordinate "$lon" E W), $(format_dms_coordinate "$lat" N S)"
}
# VALUE (validated signed decimal degrees) as D°M′S″ plus POSITIVE/NEGATIVE
# hemisphere. Integer arithmetic on 12 fraction digits rounds total seconds, so
# 59.6″ carries into the next minute instead of printing 60″.
format_dms_coordinate(){
emulate -LR zsh
local value=$1 direction=$2 fraction=""
[[ $value == -* ]]&&{ direction=$3; value=${value#-}; }
[[ $value == *.* ]]&&fraction=${value#*.}
fraction=${(r:12::0:)fraction}
local -i seconds=$(( (10#$fraction * 3600 + 500000000000) / 1000000000000 ))
local -i degrees=$(( 10#${value%%.*} + seconds / 3600 ))
seconds=$(( seconds % 3600 ))
print -rn -- "$degrees°$(( seconds / 60 ))′$(( seconds % 60 ))″$direction"
}
generate_googlemap_url(){
local lat=$1
local lon=$2
local radius=$3
if ! is_signed_decimal "$lat"||! is_signed_decimal "$lon"||! is_nonnegative_decimal "$radius";then
echo ""
return
fi
local zoom_level=15
if [[ $radius -gt 1000 ]];then
zoom_level=12
elif [[ $radius -gt 500 ]];then
zoom_level=13
elif [[ $radius -gt 250 ]];then
zoom_level=14
fi
echo "https://check.place/$lat,$lon,$zoom_level,$YY"
}
show_help(){
echo -ne "\r$shelp\n"
exit 0
}
open_report_output(){
[[ $output_fd -ge 0 ]]&&return 0
zmodload zsh/system 2>/dev/null||{
print -ru2 -- "ERROR: zsh/system is unavailable; cannot create the report safely."
return 69
}
sysopen -w -m 600 -o creat,excl,nofollow,cloexec,sync -u output_fd "$outputfile" 2>/dev/null||{
if [[ "$YY" == "cn" ]];then
print -ru2 -- "错误：无法以独占、安全模式创建报告文件：$outputfile"
else
print -ru2 -- "ERROR: cannot create the report path exclusively and safely: $outputfile"
fi
return 73
}
}
write_report_output(){
typeset ansi_report="$1"
typeset payload
case "$outputfile" in
*.[aA][nN][sS][iI])payload="$ansi_report"
;;
*.[jJ][sS][oO][nN])payload="$ipjson"
;;
*)payload=$(clean_ansi "$ansi_report" preserve)
esac
open_report_output||return $?
print -r -u "$output_fd" -- "$payload"||return 74
}
close_report_output(){
if [[ $output_fd -ge 0 ]];then
exec {output_fd}>&-
output_fd=-1
fi
}
check_IP(){
IP=$1
unset 'smail[local]' 'smail[remote]' 'smail[t]' 'smail[c]' 'smail[m]' 'smail[b]' 'smail[u]' 'smail[sdnsbl]' \
  'smail[dnsbl_results]' 'smail[blacklisted_zones]' 'smail[marked_zones]'
smailstatus=()
smail_response=()
ipjson='{
      "Head": {},
      "Info": {},
      "Type": {},
      "Score": {},
      "Factor": {},
      "Ping0": {},
      "Routing": {},
      "Exposure": {},
      "Mail": {}
    }'
[[ $2 -eq 4 ]]&&hide_ipv4 $IP
[[ $2 -eq 6 ]]&&hide_ipv6 $IP
if scope_includes reputation;then
basic_source=ipinfo
local source_id source_array
for source_id in "${reputation_source_ids[@]}";do
source_array="$source_id"
[[ "$source_id" == shodan ]]&&source_array=internetdb
# Clear all fields between families, including deselected providers.
set -A "$source_array" status disabled risk_status disabled
if reputation_source_selected "$source_id";then
"${reputation_source_functions[$source_id]}" "$2"
fi
done
fi
scope_includes mail&&check_mail
if scope_includes dnsbl&&[[ $2 -eq 4 ]];then
check_dnsbl "$IP" "$dnsbl_concurrency"
fi
echo -ne "$Font_LineClear" 1>&2
local ip_report=$(
show_head
if scope_includes reputation;then
if [[ "$basic_source" == maxmind ]];then
show_basic
else
show_basic_lite
fi
show_cloudflare_basic
show_type
show_score
show_factor
show_network_context
show_unavailable_sources
fi
scope_includes mail&&show_mail $2
scope_includes dnsbl&&[[ $2 -eq 4 ]]&&show_dnsbl
show_tail
)
if [[ mode_json -eq 1 || mode_output -eq 1 ]];then
save_json||return 70
fi
[[ mode_json -eq 0 ]]&&print -r -- "$ip_report"
[[ mode_json -eq 1 ]]&&print -r -- "$ipjson"
if [[ mode_output -eq 1 ]];then
write_report_output "$ip_report"||return $?
fi
return 0
}
# Sourcing loads definitions only (offline self-test); executing runs the CLI.
[[ "${(j: :)zsh_eval_context[@]}" == *file ]]&&return 0
parse_cli "$@"||exit $?
if [[ $version_requested -eq 1 ]];then
print -r -- "$script_version"
exit 0
fi
if [[ $help_requested -eq 1 ]];then
show_help
fi
set_language
if [[ -n "$requested_ip" ]];then
prepare_explicit_target||true
fi
[[ $ERRORcode -eq 0 && ( "$query_scope" == "dnsbl" || "$query_scope" == "mail-dnsbl" ) && $IPV4check -eq 0 ]]&&ERRORcode=61
if [[ $ERRORcode -ne 0 ]];then
echo -ne "\r$Font_B$Font_Red${swarn[$ERRORcode]}$Font_Suffix\n"
exit $ERRORcode
fi
# Every option is validated before the network-free plan is printed.
if [[ $network_lookup_confirmed -ne 1 || $plan_only -eq 1 ]];then
print_query_plan
exit 0
fi
provider_load_credentials "" "$SCRIPT_DIR/secrets"||exit $?
require_dependencies||exit $?
check_reference_files||exit $?
set_report_time
if [[ -z "$requested_ip" ]];then
if [[ $IPV4check -ne 0 ]];then
get_ipv4
is_valid_ipv4 "$IPV4"
else
IPV4work=0
fi
if [[ $IPV6check -ne 0 ]];then
get_ipv6
is_valid_ipv6 "$IPV6"
else
IPV6work=0
fi
fi
[[ $IPV4check -eq 1 && $IPV6check -eq 0 && $IPV4work -eq 0 ]]&&ERRORcode=40
[[ $IPV4check -eq 0 && $IPV6check -eq 1 && $IPV6work -eq 0 ]]&&ERRORcode=60
[[ $ERRORcode -eq 0 && $IPV4work -eq 0 && $IPV6work -eq 0 ]]&&ERRORcode=7
if [[ $ERRORcode -ne 0 ]];then
echo -ne "\r$Font_B$Font_Red${swarn[$ERRORcode]}$Font_Suffix\n"
exit $ERRORcode
fi
typeset final_status=0
if [[ $IPV4work -ne 0 && $IPV4check -ne 0 ]];then
check_IP "$IPV4" 4||final_status=$?
fi
if [[ $final_status -eq 0 && $IPV6work -ne 0 && $IPV6check -ne 0 ]];then
check_IP "$IPV6" 6||final_status=$?
fi
close_report_output
exit $final_status

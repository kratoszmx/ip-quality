get_sorted_mx_records(){
local domain=$1
dig +short MX $domain|sort -n|head -1|awk '{print $2}'
}
smtp_probe(){
local host="$1"
local port="$2"
local wait_seconds="$3"
printf 'QUIT\r\n'|nc -w "$wait_seconds" "$host" "$port" 2>&1
}
check_email_service(){
local service=$1
local port=25
local expected_response="220"
local domain=""
local host=""
local response=""
local success="false"
case $service in
"Gmail")domain="gmail.com";;
"Outlook")domain="outlook.com";;
"Yahoo")domain="yahoo.com";;
"Apple")domain="me.com";;
"MailRU")domain="mail.ru";;
"AOL")domain="aol.com";;
"GMX")domain="gmx.com";;
"MailCOM")domain="mail.com";;
"163")domain="163.com";;
"Sohu")domain="sohu.com";;
"Sina")domain="sina.com";;
"QQ")domain="qq.com";;
*)return
esac
if [[ -z $host ]];then
local mx_hosts=($(get_sorted_mx_records $domain))
for host in "${mx_hosts[@]}";do
response=$(smtp_probe "$host" "$port" 4)
smail_response[$service]=$response
if [[ $response == *"$expected_response"* ]];then
success="true"
smail[$service]="$Font_Black+$Font_Suffix$Back_Green$Font_White$Font_B$service$Font_Suffix"
smailstatus[$service]="true"
smail[remote]=1
break
fi
done
else
response=$(smtp_probe "$host" "$port" 4)
if [[ $response == *"$expected_response"* ]];then
success="true"
smail[$service]="$Font_Black+$Font_Suffix$Back_Green$Font_White$Font_B$service$Font_Suffix"
smailstatus[$service]="true"
smail[remote]=1
fi
fi
if [[ $success == "false" ]];then
smail[$service]="$Font_Black-$Font_Suffix$Back_Red$Font_White$Font_B$service$Font_Suffix"
smailstatus[$service]="false"
fi
}
check_mail(){
smail[local]=0
local response=$(smtp_probe "smtp.mailgun.org" 25 9)
[[ $response == *"220"* ]]&&smail[local]=1
smail[remote]=0
services=("Gmail" "Outlook" "Yahoo" "Apple" "QQ" "MailRU" "AOL" "GMX" "MailCOM" "163" "Sohu" "Sina")
for service in "${services[@]}";do
local temp_info="$Font_Cyan$Font_B${sinfo[mail]}$Font_I$service$Font_Suffix "
((ibar_step+=3))
show_progress_bar "$temp_info" $((40-1-${#service}-${sinfo[lmail]}))
check_email_service $service
done
}
summarize_dnsbl_results(){
local total=0
local clean=0
local blacklisted=0
local other=0
local unknown=0
local line
while IFS= read -r line;do
[[ "$line" == *$'\t'* ]]&&line="${line##*$'\t'}"
((total++))
case "$line" in
"Clean")((clean++));;
"Blacklisted")((blacklisted++));;
"Other"|"Marked")((other++));;
*)((unknown++))
esac
done
print -r -- "$total $clean $other $blacklisted $unknown"
}
check_dnsbl_parallel(){
local ip_to_check="$1"
local parallel_jobs="$2"
local -a ip_octets=("${(@s:.:)ip_to_check}")
local reversed_ip="${ip_octets[3]}.${ip_octets[2]}.${ip_octets[1]}.${ip_octets[0]}"
sort -u "$DNSBL_FILE"|xargs -P "$parallel_jobs" -I {} /bin/zsh -fc '
  emulate -LR zsh
  local reversed_ip="$1"
  local zone="$2"
  local result
  result=$(dig +time=3 +tries=1 +short "$reversed_ip.$zone" A 2>/dev/null)
  local lookup_status=$?
  if (( lookup_status != 0 )); then
    printf "%s\t%s\n" "$zone" "Unknown"
  elif [[ "$result" == 127.255.255.* ]]; then
    printf "%s\t%s\n" "$zone" "Unknown"
  elif [[ -z "$result" ]]; then
    printf "%s\t%s\n" "$zone" "Clean"
  elif [[ "$result" == "127.0.0.2" ]]; then
    printf "%s\t%s\n" "$zone" "Blacklisted"
  else
    printf "%s\t%s\n" "$zone" "Marked"
  fi
' ip-quality-dnsbl "$reversed_ip" "{}"|LC_ALL=C sort
}
check_dnsbl(){
local temp_info="$Font_Cyan$Font_B${sinfo[dnsbl]} $Font_Suffix"
((ibar_step=95))
show_progress_bar "$temp_info" $((40-1-${sinfo[ldnsbl]}))
local dnsbl_results=$(check_dnsbl_parallel "$IP" "$2")
local num_array=($(print -r -- "$dnsbl_results"|summarize_dnsbl_results))
smail[t]=${num_array[0]:-0}
smail[c]=${num_array[1]:-0}
smail[m]=${num_array[2]:-0}
smail[b]=${num_array[3]:-0}
smail[u]=${num_array[4]:-0}
smail[dnsbl_results]="$dnsbl_results"
smail[blacklisted_zones]=$(print -r -- "$dnsbl_results"|awk -F '\t' '$2 == "Blacklisted" {print $1}'|paste -sd, -|sed 's/,/, /g')
smail[marked_zones]=$(print -r -- "$dnsbl_results"|awk -F '\t' '$2 == "Marked" {print $1}'|paste -sd, -|sed 's/,/, /g')
smail[sdnsbl]="$Font_Cyan${smail[dnsbl]}  ${smail[available]}${smail[t]}   ${smail[clean]}${smail[c]}   ${smail[marked]}${smail[m]}   ${smail[blacklisted]}${smail[b]}   ${smail[unknown]}${smail[u]}$Font_Suffix"
}
show_head(){
echo -ne "\r$(printf '%72s'|tr ' ' '#')\n"
if [ $fullIP -eq 1 ];then
calc_padding "$(printf '%*s' "${shead[ltitle]}" '')$IP" 72
echo -ne "\r$PADDING$Font_B${shead[title]}$Font_Cyan$IP$Font_Suffix\n"
else
calc_padding "$(printf '%*s' "${shead[ltitle]}" '')$IPhide" 72
echo -ne "\r$PADDING$Font_B${shead[title]}$Font_Cyan$IPhide$Font_Suffix\n"
fi
calc_padding "${shead[git]}" 72
echo -ne "\r$PADDING$Font_U${shead[git]}$Font_Suffix\n"
echo -ne "\r${shead[ptime]}${shead[time]}  ${shead[ver]}\n"
echo -ne "\r$(printf '%72s'|tr ' ' '#')\n"
}

typeset -a shelp_lines=(
"IP QUALITY CHECK SCRIPT IP质量体检脚本"
"Safe default: /bin/zsh ./bin/ip-quality [--scope SCOPE]"
"安全默认：不加确认参数时只显示查询计划，不访问网络"
"Live query: /bin/zsh ./bin/ip-quality --confirm-network-lookup [--scope SCOPE] [-4|-6]"
"            --scope reputation|dnsbl|mail|mail-dnsbl|full"
"            --sources all|independent|ID,ID Select reputation sources                 选择信誉来源"
"            --ipqs-dns auto|system|alidns    IPQS DNS (default: auto)          IPQS解析策略"
"            --dnsbl-concurrency 1..50       Bounded DNSBL workers                     DNSBL并发上限"
"            --plan                          Print disclosure plan only                仅显示披露计划"
